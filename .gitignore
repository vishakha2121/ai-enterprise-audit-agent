# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Production builds
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/

# Vite
.vite/
frontend/dist/

# ==========================================
# 📦 PACKAGE MANAGERS
# ==========================================

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm

# yarn
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity

# pnpm
.pnpm-debug.log*

# ==========================================
# 🎨 EDITORS / IDE
# ==========================================

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains / PyCharm / WebStorm
.idea/
*.iml
*.ipr
*.iws
.fleet/

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# Sublime
*.sublime-workspace

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ==========================================
# 🖥️ OS FILES
# ==========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.Trash-*
.nfs*

# ==========================================
# 📝 LOGS
# ==========================================

*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

