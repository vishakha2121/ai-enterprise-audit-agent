# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm

# yarn
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity

# pnpm
.pnpm-debug.log*

