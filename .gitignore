# 🗄️ DATABASE
# ==========================================

*.db
*.sqlite
*.sqlite3
*.db-journal
audit_agent.db
database/*.db

# ==========================================
# 📁 UPLOADS / USER FILES
# ==========================================

backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/documents/*
backend/uploads/evidence/*
backend/uploads/reports/*

# Keep folder structure but ignore files
!backend/uploads/documents/.gitkeep
!backend/uploads/evidence/.gitkeep
!backend/uploads/reports/.gitkeep

# ==========================================
# 📊 GENERATED REPORTS
# ==========================================

*.pdf
!docs/**/*.pdf
backend/generated_reports/

# ==========================================
# 🔐 SECRETS & KEYS
# ==========================================

*.pem
*.key
*.crt
secrets/
.secrets/
config/secrets.yaml

# ==========================================
# ⚛️ NODE / FRONTEND
# ==========================================

# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Production builds
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/

# Vite
.vite/
frontend/dist/

